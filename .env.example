# Frontend environment — copy to `.env.local` (dev) or EasyPanel env

NEXT_PUBLIC_SITE_URL=https://sunuyaram.shop
NEXT_PUBLIC_API_URL=https://api.sunuyaram.shop
NEXT_PUBLIC_BRAND_NAME=SUNU YARAMA

# Web pixel IDs (public — safe in frontend)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# MaxMind GeoIP configuration for backend order validation (Do not expose API key to frontend client)
# Used to block orders outside Senegal and block VPNs
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Optional
NEXT_PUBLIC_GA4_ID=
